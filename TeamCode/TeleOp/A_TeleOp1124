  /**
   * Describe this function...
   */
  private void shootdelay(int targetVelocity) {
    boolean isShooting;

    isShooting = true;
    while (isShooting) {
      DriveInputs();
      if (((DcMotorEx) shootwheel).getVelocity() <= targetVelocity) {
        isShooting = false;
        feederMotor.setPower(-1);
        Dtime = getRuntime() + 0.8;
        while (!(Dtime <= getRuntime())) {
          DriveInputs();
        }
        ((DcMotorEx) shootwheel).setVelocity(0);
        feederMotor.setPower(0);
      }
    }
  }

  /**
   * Describe this function...
   */
  private void shoot3(int delay) {//if(okToShoot && these_buttons_are_pressed)
    for (int count = 0; count < 3; count++) {
      DriveInputs();
      Dtime = getRuntime() + delay;
      while (!(Dtime <= getRuntime())) {
        DriveInputs();
      }
      feederMotor.setPower(-1);
      Dtime = getRuntime() + 0.8;
      while (!(Dtime <= getRuntime())) {
        DriveInputs();
      }
      feederMotor.setPower(0);
    }
    shootwheel.setPower(0);
  }
